<Window x:Class="DragAndDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DragAndDrop"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1000" Background="#FF464141">

    <Border BorderThickness="4">
        <Canvas x:Name="Drop" AllowDrop="True" Background="DarkSlateGray" Drop="Canvas_Drop" Margin="0,-4,521,6">
            <Rectangle
                x:Name="GreenRec"
                Canvas.Left="100"
                Canvas.Top="100"
                Width="50"
                Height="50"
                Fill="green" MouseMove="GreenRec_MouseMove"
            />
        </Canvas>
    </Border>
</Window>
