<Window x:Class="FL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Left" Margin="140,110,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Height="86" Width="217" Click="Button_Click" BorderBrush="#FF540000" Foreground="#FFECC1C1" Background="#FFD85151">
            <Button Content="Button" FontSize="36" FontWeight="Bold">
                <Button.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Foreground>
            </Button>
        </Button>
        <Button x:Name="button" Grid.Column="1" Content="Button" HorizontalAlignment="Left" Margin="374,153,0,0" VerticalAlignment="Top" Height="89" Width="124"/>

    </Grid>
</Window>
