<Window x:Class="FL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Left" Margin="374,40,0,0" VerticalAlignment="Top" Height="86" Width="217" Click="Button_Click" BorderBrush="#FF540000" Foreground="#FFECC1C1" Background="#FFD85151" Grid.Column="1">
            <Button Content="Button" FontSize="36" FontWeight="Bold">
                <Button.Foreground>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Foreground>
            </Button>
        </Button>
        <Button x:Name="button" Grid.Column="1" Content="Button" HorizontalAlignment="Left" Margin="76,0,0,0" VerticalAlignment="Center" Height="53" Width="150" Click="ok"/>
        <TextBox x:Name="mimmi" Grid.Column="1" HorizontalAlignment="Left" Margin="74,107,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="141" Height="51"/>
        <Border BorderBrush="Black" BorderThickness="10
                " Grid.Column="1" Margin="271,154,129,20" Background="#FF961717"/>

    </Grid>
</Window>
